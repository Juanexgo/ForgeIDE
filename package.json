{
  "name": "forgeide",
  "version": "0.9.1-alpha.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:extension": "yarn workspace @forgeide/workbench build",
    "build": "yarn build:engine && yarn build:extension && yarn workspace @forgeide/desktop build",
    "start": "yarn workspace @forgeide/desktop start",
    "download:plugins": "theia download:plugins --parallel=false",
    "rebuild": "yarn workspace @forgeide/desktop rebuild",
    "package:mac": "yarn workspace @forgeide/desktop package:mac",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "yarn workspace @forgeide/workbench run typecheck",
    "build:engine": "node scripts/build-engine.mjs",
    "test:docker": "node --test tests/integration/docker.test.cjs",
    "test:crash": "node --test tests/integration/engine-crash.test.cjs",
    "test:dependencies": "node --test tests/integration/dependencies.test.cjs",
    "test:ollama": "node --test tests/integration/ollama.test.cjs",
    "test:protocol": "node --test tests/integration/language.test.cjs tests/integration/dap.test.cjs",
    "prepare:qa": "node scripts/prepare-qa.mjs",
    "test:agents": "node --test tests/integration/agents-matrix.test.cjs",
    "benchmark:search": "node scripts/compare-search.mjs"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "@types/node": "24.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "jsdom": "27.2.0",
    "typescript": "5.8.3"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.microsoft-authentication"
  ],
  "resolutions": {
    "**/yauzl": "^3.4.0",
    "**/adm-zip": "^0.6.1",
    "**/cross-spawn": "^7.0.6",
    "**/serialize-javascript": "7.1.3",
    "**/puppeteer": "25.18.1",
    "**/puppeteer-core": "25.18.1",
    "**/dompurify": "3.4.18",
    "**/uuid": "11.1.1",
    "**/@tootallnate/once": "2.0.1",
    "**/mocha/diff": "8.0.3",
    "**/katex": "0.18.2",
    "**/mocha/glob": "14.0.2",
    "**/@theia/filesystem/rimraf/glob": "14.0.2",
    "**/mocha/minimatch": "11.0.1",
    "**/@theia/filesystem/minimatch": "11.0.1",
    "**/opfs-worker/minimatch": "11.0.1",
    "**/@theia/ai-ide/minimatch": "11.0.1",
    "**/@theia/navigator/minimatch": "11.0.1",
    "**/@theia/search-in-workspace/minimatch": "11.0.1",
    "**/app-builder-lib/minimatch": "11.0.1",
    "**/@electron/universal/minimatch": "11.0.1"
  }
}
